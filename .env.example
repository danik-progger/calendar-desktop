# Auth service origin, without /api/auth. Use HTTPS for deployed services.
AUTH_BASE_URL=http://127.0.0.1:3001
# Rust calendar API origin.
CALENDAR_API_URL=http://127.0.0.1:8080
# Google OAuth client of type Desktop app; also set this ID in the BFF.
GOOGLE_DESKTOP_CLIENT_ID=
# Optional installed-app client secret from Google's Desktop app credentials.
# Never use the web OAuth client secret here.
GOOGLE_DESKTOP_CLIENT_SECRET=
